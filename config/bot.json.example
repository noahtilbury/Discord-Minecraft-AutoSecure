        "components_v2": {
            "_comment": "Minelink-style Components V2 cards. Colours accept '#52A435', '0x52A435' or a decimal int. Set a button's emoji to \"\" to remove it. Thumbnails accept a URL, or 'attachment://minelink.png' for local files in assets/ (the /send embed command attaches them).",
            "colors": {
                "success": "#52A435",
                "error": "#ED4245",
